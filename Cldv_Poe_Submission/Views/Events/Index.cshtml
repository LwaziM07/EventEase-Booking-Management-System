@model IEnumerable<Cldv_Poe_Submission.Models.Event>

@{
    ViewData["Title"] = "Index";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <!--Error message is called and displayed (Co., 2022)-->
        @TempData["ErrorMessage"]
    </div>
}
<h1>Manage Events</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="card mb-3">
    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row align-items-end mb-3">
                <div class="col-md-4">
                    <label>Event Type</label>
                    <select name="eventTypeID" asp-items="ViewBag.EventTypeID" class="form-control">
                        <option value="">All Types</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label>From Date</label>
                    <input type="date" name="startDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label>To Date</label>
                    <input type="date" name="endDate" class="form-control" />
                </div>

                <div class="col-md-2">
                    <button type="submit" value="Filter" class="btn btn-primary">
                        Filter
                    </button>
                </div>

            </div>


        </form>

    </div>
</div>


<div class="card p-3">
    <!--Wraps the item in a container and gives it padding-->
    @if (Model.Any())
    {
        <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.EventName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.StartDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EndDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EventDescription)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EventType)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EventImageUrl)
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.EventName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.StartDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EndDate)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.EventDescription)
                    </td>
                    <td>
                            @Html.DisplayFor(modelItem => item.EventType.EventType)
                    </td>
                    <td>
                        @if (string.IsNullOrEmpty(item.EventImageUrl))
                        {
                            <span>No Image</span>
                        }
                        else
                        {
                            <img src="@item.EventImageUrl" style="width:100px; height: auto;" />
                        }

                    </td>
                     <td class="text-nowrap">
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-primary btn-sm">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                        
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
    else
    {
        <p>No events found within the given search parameters.</p>
    }
</div>

