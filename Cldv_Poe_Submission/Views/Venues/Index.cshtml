@model IEnumerable<Cldv_Poe_Submission.Models.Venue>

@{
    ViewData["Title"] = "Index";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <!--Error message is called and displayed (Co., 2022)-->
        @TempData["ErrorMessage"]
    </div>
}
<h1>Manage Venues</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<form asp-action="Index" method="get">
    <div class="form-check">
        <input type="checkbox"name="OnlyAvailable"value="true"class="form-check-input"/>

        <label class="form-check-label"> Show Available Venues Only </label>
    </div>

    <input type="submit" value="Search" class="btn btn-primary" />
</form>
<div class="card p-3">
    <!--Wraps the item in a container and gives it padding-->
    @if (Model.Any())
    {
        <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.VenueName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VenueLocation)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Capacity)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Availability)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ImageUrl)
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.VenueName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.VenueLocation)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Capacity)
                    </td>
                    <td>
                        @if (item.Availability)
                        {
                            <span class="bg-success-subtle">Available</span>
                        }
                        else
                        {
                            <span class="bg-danger-subtle">Unavailable</span>
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <span>No Image</span>
                        }
                        else
                        {
                            <img src="@item.ImageUrl" style="width:100px; height: auto;" />
                        }

                    </td>
                    <td class="text-nowrap">
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.VenueId" class="btn btn-primary btn-sm">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.VenueId" class="btn btn-info btn-sm">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.VenueId" class="btn btn-danger btn-sm">Delete</a>
                            </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
    else
    {
        <p>No venues found within the given search parameters.</p>
    }
</div>

